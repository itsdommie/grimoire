{
  "name": "grimoire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ingest": "npm run ingest -w @grimoire/server",
    "dev:server": "npm run dev -w @grimoire/server",
    "dev:web": "npm run dev -w @grimoire/web",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
